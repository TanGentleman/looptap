{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looptap.dev/schemas/tracers.analyze.v1.request.json",
  "title": "tracers.analyze/v1 Request",
  "description": "Redacted evidence sent from tracers to Modal for LLM rule polish.",
  "type": "object",
  "required": [
    "api_version",
    "request_id",
    "card_id",
    "pattern",
    "redacted_evidence",
    "template_rule"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "tracers.analyze/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "card_id": {
      "type": "string",
      "minLength": 1
    },
    "pattern": {
      "type": "object",
      "required": ["signal", "tool", "error_class", "summary", "session_count"],
      "additionalProperties": false,
      "properties": {
        "signal": { "type": "string" },
        "tool": { "type": "string" },
        "error_class": { "type": "string" },
        "summary": { "type": "string" },
        "session_count": { "type": "integer", "minimum": 0 }
      }
    },
    "redacted_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool_name", "is_error", "excerpt", "redactions"],
        "additionalProperties": false,
        "properties": {
          "tool_name": { "type": "string" },
          "is_error": { "type": "boolean" },
          "excerpt": { "type": "string" },
          "redactions": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "template_rule": {
      "type": "object",
      "required": ["title", "snippet", "target", "confidence"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "snippet": { "type": "string" },
        "target": {
          "type": "string",
          "enum": ["AGENTS.md", "CLAUDE.md"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    }
  }
}
